<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_ColdChainReplenishment"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.25.0">

  <!-- Message Definitions -->
  <bpmn:message id="Message_QuoteReceived" name="QuoteReceived">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=requestId + &#34;-&#34; + supplier.supplierId" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_ShipmentDelivered" name="ShipmentDelivered">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=poResult.poNumber" />
    </bpmn:extensionElements>
  </bpmn:message>

  <bpmn:message id="Message_TempExcursionDetected" name="TempExcursionDetected">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=poResult.poNumber" />
    </bpmn:extensionElements>
  </bpmn:message>

  <!-- Error Definitions -->
  <bpmn:error id="Error_ShipmentRejected" name="Shipment Rejected" errorCode="SHIPMENT_REJECTED" />

  <!-- Main Process -->
  <bpmn:process id="coldChainReplenishment" name="Cold-Chain Replenishment Main Process" isExecutable="true">

    <!-- 1. Start Event -->
    <bpmn:startEvent id="StartEvent_ReplenishmentRequested" name="Replenishment Requested">
      <bpmn:outgoing>Flow_StartToReview</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- 2. User Task: Review & Approve Replenishment Request -->
    <bpmn:userTask id="Task_ReviewRequest" name="Review &amp; Approve Replenishment Request">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="reviewReplenishmentRequest" />
        <zeebe:ioMapping>
          <zeebe:input source="=requestId" target="requestId" />
          <zeebe:input source="=storeId" target="storeId" />
          <zeebe:input source="=storeManagerEmail" target="storeManagerEmail" />
          <zeebe:input source="=maxTransitTempC" target="maxTransitTempC" />
          <zeebe:input source="=budgetCap" target="budgetCap" />
          <zeebe:input source="=items" target="items" />
          <zeebe:input source="=suppliers" target="suppliers" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ReviewToGateway</bpmn:outgoing>
    </bpmn:userTask>

    <!-- 3. Exclusive Gateway: Request Approved? -->
    <bpmn:exclusiveGateway id="Gateway_RequestApproved" name="Request Approved?" default="Flow_RequestApproved">
      <bpmn:incoming>Flow_ReviewToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RequestApproved</bpmn:outgoing>
      <bpmn:outgoing>Flow_RequestRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Rejection End Event -->
    <bpmn:endEvent id="EndEvent_RequestRejected" name="Request Rejected">
      <bpmn:incoming>Flow_RequestRejected</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 4. Parallel Multi-Instance Sub-Process: RFQ per Supplier -->
    <bpmn:subProcess id="SubProcess_RFQPerSupplier" name="RFQ per Supplier">
      <bpmn:incoming>Flow_RequestApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_RFQToQuoteGateway</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=suppliers" inputElement="supplier" outputCollection="quotes" outputElement="=quote" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>

      <!-- Sub-Process Start -->
      <bpmn:startEvent id="StartEvent_RFQInstance" name="RFQ Instance Started">
        <bpmn:outgoing>Flow_RFQStartToSendEmail</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- Email Connector: Send RFQ to Supplier -->
      <bpmn:serviceTask id="Task_SendRFQEmail" name="Send RFQ to Supplier">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:email:1" />
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.SMTP_HOST}}" target="host" />
            <zeebe:input source="{{secrets.SMTP_PORT}}" target="port" />
            <zeebe:input source="{{secrets.SMTP_USER}}" target="user" />
            <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="password" />
            <zeebe:input source="procurement@coldchain-replenishment.example" target="from" />
            <zeebe:input source="=supplier.email" target="to" />
            <zeebe:input source="=&#34;RFQ for Store &#34; + storeId + &#34; - Request &#34; + requestId" target="subject" />
            <zeebe:input source="=&#34;Dear &#34; + supplier.name + &#34;, please submit your quotation for Request &#34; + requestId + &#34;. Correlation key: &#34; + requestId + &#34;-&#34; + supplier.supplierId" target="body" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_RFQStartToSendEmail</bpmn:incoming>
        <bpmn:outgoing>Flow_SendEmailToWaitSub</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- Embedded Wait Sub-Process with Interrupting Boundary Timer -->
      <bpmn:subProcess id="SubProcess_WaitForQuote" name="Wait for Supplier Quote">
        <bpmn:incoming>Flow_SendEmailToWaitSub</bpmn:incoming>
        <bpmn:outgoing>Flow_WaitSubToSetReceived</bpmn:outgoing>

        <bpmn:startEvent id="StartEvent_WaitSub" name="Start Wait">
          <bpmn:outgoing>Flow_WaitStartToCatch</bpmn:outgoing>
        </bpmn:startEvent>

        <bpmn:intermediateCatchEvent id="Event_QuoteReceived" name="Quote Received">
          <bpmn:incoming>Flow_WaitStartToCatch</bpmn:incoming>
          <bpmn:outgoing>Flow_CatchToWaitEnd</bpmn:outgoing>
          <bpmn:messageEventDefinition id="MsgEventDef_QuoteReceived" messageRef="Message_QuoteReceived" />
        </bpmn:intermediateCatchEvent>

        <bpmn:endEvent id="EndEvent_WaitSub" name="Quote Caught">
          <bpmn:incoming>Flow_CatchToWaitEnd</bpmn:incoming>
        </bpmn:endEvent>

        <bpmn:sequenceFlow id="Flow_WaitStartToCatch" sourceRef="StartEvent_WaitSub" targetRef="Event_QuoteReceived" />
        <bpmn:sequenceFlow id="Flow_CatchToWaitEnd" sourceRef="Event_QuoteReceived" targetRef="EndEvent_WaitSub" />
      </bpmn:subProcess>

      <!-- Interrupting Boundary Timer Event (Demo: PT2M, Production: PT4H) -->
      <bpmn:boundaryEvent id="BoundaryEvent_QuoteTimeout" name="Quote Timeout (PT2M)" attachedToRef="SubProcess_WaitForQuote" cancelActivity="true">
        <bpmn:outgoing>Flow_TimeoutToSetTimedOut</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_QuoteTimeout">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>

      <!-- Script Task: Set Received Quote -->
      <bpmn:scriptTask id="Task_SetReceivedQuote" name="Record Received Quote">
        <bpmn:extensionElements>
          <zeebe:script expression="={ supplierId: supplier.supplierId, price: quotePrice, responded: true }" resultVariable="quote" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_WaitSubToSetReceived</bpmn:incoming>
        <bpmn:outgoing>Flow_SetReceivedToJoin</bpmn:outgoing>
      </bpmn:scriptTask>

      <!-- Script Task: Set Timed-Out Quote -->
      <bpmn:scriptTask id="Task_SetTimedOutQuote" name="Record Timed-Out Quote">
        <bpmn:extensionElements>
          <zeebe:script expression="={ supplierId: supplier.supplierId, price: null, responded: false }" resultVariable="quote" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TimeoutToSetTimedOut</bpmn:incoming>
        <bpmn:outgoing>Flow_SetTimedOutToJoin</bpmn:outgoing>
      </bpmn:scriptTask>

      <!-- Exclusive Gateway Join for Quote Outcomes -->
      <bpmn:exclusiveGateway id="Gateway_JoinQuoteOutcome" name="Join Quote Outcome" default="Flow_QuoteJoinToEnd">
        <bpmn:incoming>Flow_SetReceivedToJoin</bpmn:incoming>
        <bpmn:incoming>Flow_SetTimedOutToJoin</bpmn:incoming>
        <bpmn:outgoing>Flow_QuoteJoinToEnd</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:endEvent id="EndEvent_RFQInstance" name="RFQ Instance Completed">
        <bpmn:incoming>Flow_QuoteJoinToEnd</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Sub-Process Sequence Flows -->
      <bpmn:sequenceFlow id="Flow_RFQStartToSendEmail" sourceRef="StartEvent_RFQInstance" targetRef="Task_SendRFQEmail" />
      <bpmn:sequenceFlow id="Flow_SendEmailToWaitSub" sourceRef="Task_SendRFQEmail" targetRef="SubProcess_WaitForQuote" />
      <bpmn:sequenceFlow id="Flow_WaitSubToSetReceived" sourceRef="SubProcess_WaitForQuote" targetRef="Task_SetReceivedQuote" />
      <bpmn:sequenceFlow id="Flow_TimeoutToSetTimedOut" sourceRef="BoundaryEvent_QuoteTimeout" targetRef="Task_SetTimedOutQuote" />
      <bpmn:sequenceFlow id="Flow_SetReceivedToJoin" sourceRef="Task_SetReceivedQuote" targetRef="Gateway_JoinQuoteOutcome" />
      <bpmn:sequenceFlow id="Flow_SetTimedOutToJoin" sourceRef="Task_SetTimedOutQuote" targetRef="Gateway_JoinQuoteOutcome" />
      <bpmn:sequenceFlow id="Flow_QuoteJoinToEnd" sourceRef="Gateway_JoinQuoteOutcome" targetRef="EndEvent_RFQInstance" />
    </bpmn:subProcess>

    <!-- 5. Exclusive Gateway: Any Valid Quotes? -->
    <bpmn:exclusiveGateway id="Gateway_AnyValidQuote" name="Any Valid Quotes?" default="Flow_NoQuotesAlert">
      <bpmn:incoming>Flow_RFQToQuoteGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidQuotesPresent</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoQuotesAlert</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Slack Connector: Alert QA / Procurement of No Quotes -->
    <bpmn:serviceTask id="Task_AlertNoQuotes" name="Alert QA: No Quotes Received">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:slack:1" />
        <zeebe:ioMapping>
          <zeebe:input source="{{secrets.SLACK_BOT_TOKEN}}" target="token" />
          <zeebe:input source="chat.postMessage" target="method" />
          <zeebe:input source="={ channel: &#34;{{secrets.SLACK_QA_CHANNEL}}&#34;, text: &#34;URGENT: No supplier quotes received for replenishment request &#34; + requestId + &#34; at store &#34; + storeId + &#34;. Escalating to Category Manager.&#34; }" target="data" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoQuotesAlert</bpmn:incoming>
      <bpmn:outgoing>Flow_AlertToNoQuotesEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_NoQuotesEscalated" name="No Quotes – Escalated">
      <bpmn:incoming>Flow_AlertToNoQuotesEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- 6. Script Task: Rank & Select Suppliers -->
    <bpmn:scriptTask id="Task_RankSelectSuppliers" name="Rank &amp; Select Suppliers">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for q in sort(quotes[item.responded = true], function(x, y) x.price &lt; y.price) return { supplierId: q.supplierId, poNumber: &#34;PO-&#34; + requestId + &#34;-&#34; + q.supplierId, items: items, amount: q.price })[item.amount &lt;= budgetCap]" resultVariable="selectedOrders" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ValidQuotesPresent</bpmn:incoming>
      <bpmn:outgoing>Flow_RankToIssuePOs</bpmn:outgoing>
    </bpmn:scriptTask>

    <!-- 7. Sequential Multi-Instance: Issue Purchase Orders -->
    <bpmn:subProcess id="SubProcess_IssuePurchaseOrders" name="Issue Purchase Orders">
      <bpmn:incoming>Flow_RankToIssuePOs</bpmn:incoming>
      <bpmn:outgoing>Flow_IssuePOsToFulfilment</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=selectedOrders" inputElement="order" outputCollection="poResults" outputElement="=poResult" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartEvent_IssuePOInstance" name="PO Dispatch Started">
        <bpmn:outgoing>Flow_IssuePOStartToPost</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- REST Connector: POST PO to Supplier API -->
      <bpmn:serviceTask id="Task_PostPOToSupplierAPI" name="POST PO to Supplier API">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="http" />
          <zeebe:ioMapping>
            <zeebe:input source="post" target="method" />
            <zeebe:input source="{{secrets.SUPPLIER_API_BASE_URL}}/orders" target="url" />
            <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Authorization&#34;: &#34;Bearer {{secrets.SUPPLIER_API_TOKEN}}&#34; }" target="headers" />
            <zeebe:input source="=order" target="body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="supplierOrderResponse" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_IssuePOStartToPost</bpmn:incoming>
        <bpmn:outgoing>Flow_PostPOToSendEmail</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- Email Connector: Send PO Confirmation Email -->
      <bpmn:serviceTask id="Task_SendPOConfirmationEmail" name="Send PO Confirmation Email">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:email:1" />
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.SMTP_HOST}}" target="host" />
            <zeebe:input source="{{secrets.SMTP_PORT}}" target="port" />
            <zeebe:input source="{{secrets.SMTP_USER}}" target="user" />
            <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="password" />
            <zeebe:input source="procurement@coldchain-replenishment.example" target="from" />
            <zeebe:input source="=&#34;supplier-&#34; + order.supplierId + &#34;@supplier.example&#34;" target="to" />
            <zeebe:input source="=&#34;Purchase Order Dispatched: &#34; + order.poNumber" target="subject" />
            <zeebe:input source="=&#34;Purchase Order &#34; + order.poNumber + &#34; has been confirmed for total amount &#34; + string(order.amount) + &#34;.&#34;" target="body" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_PostPOToSendEmail</bpmn:incoming>
        <bpmn:outgoing>Flow_SendEmailToSetResult</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- Script Task: Assemble PO Result Object -->
      <bpmn:scriptTask id="Task_SetPOResult" name="Set PO Result Object">
        <bpmn:extensionElements>
          <zeebe:script expression="={ poNumber: order.poNumber, supplierId: order.supplierId, items: order.items, amount: order.amount, poStatus: &#34;DISPATCHED&#34; }" resultVariable="poResult" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SendEmailToSetResult</bpmn:incoming>
        <bpmn:outgoing>Flow_SetResultToPOEnd</bpmn:outgoing>
      </bpmn:scriptTask>

      <bpmn:endEvent id="EndEvent_IssuePOInstance" name="PO Dispatched">
        <bpmn:incoming>Flow_SetResultToPOEnd</bpmn:incoming>
      </bpmn:endEvent>

      <bpmn:sequenceFlow id="Flow_IssuePOStartToPost" sourceRef="StartEvent_IssuePOInstance" targetRef="Task_PostPOToSupplierAPI" />
      <bpmn:sequenceFlow id="Flow_PostPOToSendEmail" sourceRef="Task_PostPOToSupplierAPI" targetRef="Task_SendPOConfirmationEmail" />
      <bpmn:sequenceFlow id="Flow_SendEmailToSetResult" sourceRef="Task_SendPOConfirmationEmail" targetRef="Task_SetPOResult" />
      <bpmn:sequenceFlow id="Flow_SetResultToPOEnd" sourceRef="Task_SetPOResult" targetRef="EndEvent_IssuePOInstance" />
    </bpmn:subProcess>

    <!-- 8. Parallel Multi-Instance Sub-Process: Shipment Fulfilment per PO -->
    <bpmn:subProcess id="SubProcess_ShipmentFulfilment" name="Shipment Fulfilment per PO">
      <bpmn:incoming>Flow_IssuePOsToFulfilment</bpmn:incoming>
      <bpmn:outgoing>Flow_FulfilmentToSummaryGateway</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=poResults" inputElement="poResult" outputCollection="shipmentResults" outputElement="=shipmentResult" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>

      <bpmn:startEvent id="StartEvent_ShipmentInstance" name="Start Shipment Fulfilment">
        <bpmn:outgoing>Flow_ShipmentStartToTransit</bpmn:outgoing>
      </bpmn:startEvent>

      <!-- Nested Embedded Sub-Process: Cold-Chain Transit -->
      <bpmn:subProcess id="SubProcess_ColdChainTransit" name="Cold-Chain Transit">
        <bpmn:incoming>Flow_ShipmentStartToTransit</bpmn:incoming>
        <bpmn:outgoing>Flow_TransitToGoodsReceipt</bpmn:outgoing>

        <bpmn:startEvent id="StartEvent_TransitActive" name="Transit In Progress">
          <bpmn:outgoing>Flow_TransitStartToCatchDelivered</bpmn:outgoing>
        </bpmn:startEvent>

        <!-- Message Intermediate Catch: Delivered -->
        <bpmn:intermediateCatchEvent id="Event_ShipmentDelivered" name="Shipment Delivered">
          <bpmn:incoming>Flow_TransitStartToCatchDelivered</bpmn:incoming>
          <bpmn:outgoing>Flow_DeliveredToFetchTelemetry</bpmn:outgoing>
          <bpmn:messageEventDefinition id="MsgEventDef_ShipmentDelivered" messageRef="Message_ShipmentDelivered" />
        </bpmn:intermediateCatchEvent>

        <!-- REST Connector: GET Final Telemetry from Mock IoT API -->
        <bpmn:serviceTask id="Task_FetchFinalTelemetry" name="GET Final IoT Telemetry">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="http" />
            <zeebe:ioMapping>
              <zeebe:input source="get" target="method" />
              <zeebe:input source="=&#34;{{secrets.IOT_API_BASE_URL}}/telemetry/&#34; + poResult.poNumber" target="url" />
              <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.IOT_API_TOKEN}}&#34; }" target="headers" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultVariable" value="telemetryData" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_DeliveredToFetchTelemetry</bpmn:incoming>
          <bpmn:outgoing>Flow_FetchToTempCheckGateway</bpmn:outgoing>
        </bpmn:serviceTask>

        <!-- Exclusive Gateway: Max Temp Exceeded? -->
        <bpmn:exclusiveGateway id="Gateway_CheckTempExceeded" name="Max Temp Exceeded?" default="Flow_TempNormal">
          <bpmn:incoming>Flow_FetchToTempCheckGateway</bpmn:incoming>
          <bpmn:outgoing>Flow_TempNormal</bpmn:outgoing>
          <bpmn:outgoing>Flow_TempExceeded</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <!-- User Task: QA Inspection -->
        <bpmn:userTask id="Task_QAInspection" name="QA Inspection">
          <bpmn:extensionElements>
            <zeebe:formDefinition formId="qaInspection" />
            <zeebe:ioMapping>
              <zeebe:input source="=poResult.poNumber" target="poNumber" />
              <zeebe:input source="=telemetryData.maxTempC" target="maxTempC" />
              <zeebe:input source="=maxTransitTempC" target="maxTransitTempC" />
              <zeebe:input source="=telemetryData" target="telemetryData" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_TempExceeded</bpmn:incoming>
          <bpmn:outgoing>Flow_QAInspectionToGateway</bpmn:outgoing>
        </bpmn:userTask>

        <!-- Exclusive Gateway: QA Inspection Decision -->
        <bpmn:exclusiveGateway id="Gateway_QAInspectionPassed" name="QA Inspection Decision?" default="Flow_QAInspectionReject">
          <bpmn:incoming>Flow_QAInspectionToGateway</bpmn:incoming>
          <bpmn:outgoing>Flow_QAInspectionPassed</bpmn:outgoing>
          <bpmn:outgoing>Flow_QAInspectionReject</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <!-- Error End Event: QA Rejects Shipment -->
        <bpmn:endEvent id="EndEvent_TransitQARejected" name="Shipment Rejected by QA">
          <bpmn:incoming>Flow_QAInspectionReject</bpmn:incoming>
          <bpmn:errorEventDefinition id="ErrorDef_TransitQARejected" errorRef="Error_ShipmentRejected" />
        </bpmn:endEvent>

        <!-- Exclusive Gateway Join for Transit Temp Inspection -->
        <bpmn:exclusiveGateway id="Gateway_TransitTempJoin" name="Join Transit Flow" default="Flow_TempJoinToEnd">
          <bpmn:incoming>Flow_TempNormal</bpmn:incoming>
          <bpmn:incoming>Flow_QAInspectionPassed</bpmn:incoming>
          <bpmn:outgoing>Flow_TempJoinToEnd</bpmn:outgoing>
        </bpmn:exclusiveGateway>

        <bpmn:endEvent id="EndEvent_TransitCompleted" name="Transit Completed">
          <bpmn:incoming>Flow_TempJoinToEnd</bpmn:incoming>
        </bpmn:endEvent>

        <!-- Event Sub-Process: IoT Temperature Excursion Handling (Non-interrupting) -->
        <bpmn:subProcess id="EventSubProcess_TempExcursion" name="IoT Temperature Excursion Handling" triggeredByEvent="true">
          <bpmn:startEvent id="StartEvent_TempExcursion" name="Temp Excursion Detected (&gt; 8°C)" isInterrupting="false">
            <bpmn:outgoing>Flow_ExcursionStartToFetch</bpmn:outgoing>
            <bpmn:messageEventDefinition id="MsgEventDef_TempExcursion" messageRef="Message_TempExcursionDetected" />
          </bpmn:startEvent>

          <!-- REST Connector: Fetch Real-time Excursion Details -->
          <bpmn:serviceTask id="Task_FetchExcursionTelemetry" name="Fetch Excursion Details">
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="http" />
              <zeebe:ioMapping>
                <zeebe:input source="get" target="method" />
                <zeebe:input source="=&#34;{{secrets.IOT_API_BASE_URL}}/telemetry/&#34; + poResult.poNumber + &#34;/excursions&#34;" target="url" />
                <zeebe:input source="={ &#34;Authorization&#34;: &#34;Bearer {{secrets.IOT_API_TOKEN}}&#34; }" target="headers" />
              </zeebe:ioMapping>
              <zeebe:taskHeaders>
                <zeebe:header key="resultVariable" value="excursionDetail" />
              </zeebe:taskHeaders>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_ExcursionStartToFetch</bpmn:incoming>
            <bpmn:outgoing>Flow_FetchToSlackAlert</bpmn:outgoing>
          </bpmn:serviceTask>

          <!-- Slack Connector: Alert QA Team -->
          <bpmn:serviceTask id="Task_AlertQAExcursion" name="Alert QA: Excursion Detected">
            <bpmn:extensionElements>
              <zeebe:taskDefinition type="io.camunda:slack:1" />
              <zeebe:ioMapping>
                <zeebe:input source="{{secrets.SLACK_BOT_TOKEN}}" target="token" />
                <zeebe:input source="chat.postMessage" target="method" />
                <zeebe:input source="={ channel: &#34;{{secrets.SLACK_QA_CHANNEL}}&#34;, text: &#34;WARNING: IoT Temperature excursion (&gt; &#34; + string(maxTransitTempC) + &#34;°C) detected for PO &#34; + poResult.poNumber + &#34;. Immediate QA triage required.&#34; }" target="data" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_FetchToSlackAlert</bpmn:incoming>
            <bpmn:outgoing>Flow_SlackToQADecision</bpmn:outgoing>
          </bpmn:serviceTask>

          <!-- User Task: QA Decision -->
          <bpmn:userTask id="Task_QADecision" name="QA Excursion Decision">
            <bpmn:extensionElements>
              <zeebe:formDefinition formId="qaDecision" />
              <zeebe:ioMapping>
                <zeebe:input source="=poResult.poNumber" target="poNumber" />
                <zeebe:input source="=excursionDetail" target="excursionDetail" />
                <zeebe:input source="=maxTransitTempC" target="maxTransitTempC" />
              </zeebe:ioMapping>
            </bpmn:extensionElements>
            <bpmn:incoming>Flow_SlackToQADecision</bpmn:incoming>
            <bpmn:outgoing>Flow_QADecisionToGateway</bpmn:outgoing>
          </bpmn:userTask>

          <!-- Exclusive Gateway: Excursion Action -->
          <bpmn:exclusiveGateway id="Gateway_ExcursionDecision" name="QA Excursion Action?" default="Flow_ExcursionAccept">
            <bpmn:incoming>Flow_QADecisionToGateway</bpmn:incoming>
            <bpmn:outgoing>Flow_ExcursionAccept</bpmn:outgoing>
            <bpmn:outgoing>Flow_ExcursionReject</bpmn:outgoing>
          </bpmn:exclusiveGateway>

          <!-- Error End Event: Triggers Boundary Error Event on ColdChainTransit -->
          <bpmn:endEvent id="EndEvent_ExcursionRejected" name="Excursion Rejected">
            <bpmn:incoming>Flow_ExcursionReject</bpmn:incoming>
            <bpmn:errorEventDefinition id="ErrorDef_ExcursionRejected" errorRef="Error_ShipmentRejected" />
          </bpmn:endEvent>

          <bpmn:endEvent id="EndEvent_ExcursionAccepted" name="Excursion Cleared">
            <bpmn:incoming>Flow_ExcursionAccept</bpmn:incoming>
          </bpmn:endEvent>

          <bpmn:sequenceFlow id="Flow_ExcursionStartToFetch" sourceRef="StartEvent_TempExcursion" targetRef="Task_FetchExcursionTelemetry" />
          <bpmn:sequenceFlow id="Flow_FetchToSlackAlert" sourceRef="Task_FetchExcursionTelemetry" targetRef="Task_AlertQAExcursion" />
          <bpmn:sequenceFlow id="Flow_SlackToQADecision" sourceRef="Task_AlertQAExcursion" targetRef="Task_QADecision" />
          <bpmn:sequenceFlow id="Flow_QADecisionToGateway" sourceRef="Task_QADecision" targetRef="Gateway_ExcursionDecision" />
          <bpmn:sequenceFlow id="Flow_ExcursionAccept" name="Accept Deviation" sourceRef="Gateway_ExcursionDecision" targetRef="EndEvent_ExcursionAccepted" />
          <bpmn:sequenceFlow id="Flow_ExcursionReject" name="Reject Shipment" sourceRef="Gateway_ExcursionDecision" targetRef="EndEvent_ExcursionRejected">
            <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qaExcursionDecision = "REJECT"</bpmn:conditionExpression>
          </bpmn:sequenceFlow>
        </bpmn:subProcess>

        <!-- Transit Sub-Process Flows -->
        <bpmn:sequenceFlow id="Flow_TransitStartToCatchDelivered" sourceRef="StartEvent_TransitActive" targetRef="Event_ShipmentDelivered" />
        <bpmn:sequenceFlow id="Flow_DeliveredToFetchTelemetry" sourceRef="Event_ShipmentDelivered" targetRef="Task_FetchFinalTelemetry" />
        <bpmn:sequenceFlow id="Flow_FetchToTempCheckGateway" sourceRef="Task_FetchFinalTelemetry" targetRef="Gateway_CheckTempExceeded" />
        <bpmn:sequenceFlow id="Flow_TempNormal" name="Within Cold Range" sourceRef="Gateway_CheckTempExceeded" targetRef="Gateway_TransitTempJoin" />
        <bpmn:sequenceFlow id="Flow_TempExceeded" name="Temp &gt; 8°C Exceeded" sourceRef="Gateway_CheckTempExceeded" targetRef="Task_QAInspection">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=telemetryData.maxTempC &gt; maxTransitTempC</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_QAInspectionToGateway" sourceRef="Task_QAInspection" targetRef="Gateway_QAInspectionPassed" />
        <bpmn:sequenceFlow id="Flow_QAInspectionPassed" name="QA Approved" sourceRef="Gateway_QAInspectionPassed" targetRef="Gateway_TransitTempJoin">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=qaInspectionPassed = true</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_QAInspectionReject" name="QA Condemned" sourceRef="Gateway_QAInspectionPassed" targetRef="EndEvent_TransitQARejected" />
        <bpmn:sequenceFlow id="Flow_TempJoinToEnd" sourceRef="Gateway_TransitTempJoin" targetRef="EndEvent_TransitCompleted" />

      </bpmn:subProcess>

      <!-- Boundary Timer Event on ColdChainTransit: Delivery SLA Breach (Demo: PT5M, Production: P2D) -->
      <bpmn:boundaryEvent id="BoundaryEvent_DeliveryTimer" name="Delivery SLA (PT5M)" attachedToRef="SubProcess_ColdChainTransit" cancelActivity="true">
        <bpmn:outgoing>Flow_LateTimerToSlack</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerDef_DeliverySLA">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:boundaryEvent>

      <!-- Slack Connector: Alert QA of Late Delivery -->
      <bpmn:serviceTask id="Task_SlackLateDelivery" name="Alert QA: Delivery Overdue">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:slack:1" />
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.SLACK_BOT_TOKEN}}" target="token" />
            <zeebe:input source="chat.postMessage" target="method" />
            <zeebe:input source="={ channel: &#34;{{secrets.SLACK_QA_CHANNEL}}&#34;, text: &#34;SLA BREACH: Shipment delivery for PO &#34; + poResult.poNumber + &#34; is overdue.&#34; }" target="data" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_LateTimerToSlack</bpmn:incoming>
        <bpmn:outgoing>Flow_SlackToEmailLateSupplier</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- Email Connector: Notify Supplier of Overdue Delivery -->
      <bpmn:serviceTask id="Task_EmailSupplierLate" name="Email Supplier: Overdue Notice">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:email:1" />
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.SMTP_HOST}}" target="host" />
            <zeebe:input source="{{secrets.SMTP_PORT}}" target="port" />
            <zeebe:input source="{{secrets.SMTP_USER}}" target="user" />
            <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="password" />
            <zeebe:input source="procurement@coldchain-replenishment.example" target="from" />
            <zeebe:input source="=&#34;supplier-&#34; + poResult.supplierId + &#34;@supplier.example&#34;" target="to" />
            <zeebe:input source="=&#34;URGENT: Delivery SLA Breach for PO &#34; + poResult.poNumber" target="subject" />
            <zeebe:input source="=&#34;Your shipment for PO &#34; + poResult.poNumber + &#34; has exceeded the cold-chain transit SLA. Immediate status update required.&#34;" target="body" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SlackToEmailLateSupplier</bpmn:incoming>
        <bpmn:outgoing>Flow_EmailLateToSetResult</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:scriptTask id="Task_SetShipmentLateResult" name="Set Shipment Late Result">
        <bpmn:extensionElements>
          <zeebe:script expression="={ poNumber: poResult.poNumber, supplierId: poResult.supplierId, status: &#34;LATE&#34;, matchStatus: &#34;NOT_APPLICABLE&#34; }" resultVariable="shipmentResult" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_EmailLateToSetResult</bpmn:incoming>
        <bpmn:outgoing>Flow_LateResultToEnd</bpmn:outgoing>
      </bpmn:scriptTask>

      <bpmn:endEvent id="EndEvent_DeliveryLate" name="Delivery Late">
        <bpmn:incoming>Flow_LateResultToEnd</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Boundary Error Event on ColdChainTransit: Shipment Rejected -->
      <bpmn:boundaryEvent id="BoundaryEvent_ShipmentRejected" name="Shipment Rejected Error" attachedToRef="SubProcess_ColdChainTransit">
        <bpmn:outgoing>Flow_RejectedToSlack</bpmn:outgoing>
        <bpmn:errorEventDefinition id="ErrorDef_BoundaryShipmentRejected" errorRef="Error_ShipmentRejected" />
      </bpmn:boundaryEvent>

      <!-- Slack Connector: Alert QA of Rejection -->
      <bpmn:serviceTask id="Task_SlackShipmentRejected" name="Alert QA: Shipment Rejected">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:slack:1" />
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.SLACK_BOT_TOKEN}}" target="token" />
            <zeebe:input source="chat.postMessage" target="method" />
            <zeebe:input source="={ channel: &#34;{{secrets.SLACK_QA_CHANNEL}}&#34;, text: &#34;CRITICAL: Cold-chain shipment rejected for PO &#34; + poResult.poNumber + &#34; due to quality/temperature violation. Supplier dispute opened.&#34; }" target="data" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_RejectedToSlack</bpmn:incoming>
        <bpmn:outgoing>Flow_SlackToRestRejectPO</bpmn:outgoing>
      </bpmn:serviceTask>

      <!-- REST Connector: Mark PO Rejected in Supplier API -->
      <bpmn:serviceTask id="Task_RestMarkPORejected" name="Mark PO Rejected in Supplier API">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="http" />
          <zeebe:ioMapping>
            <zeebe:input source="post" target="method" />
            <zeebe:input source="=&#34;{{secrets.SUPPLIER_API_BASE_URL}}/orders/&#34; + poResult.poNumber + &#34;/reject&#34;" target="url" />
            <zeebe:input source="={ &#34;Content-Type&#34;: &#34;application/json&#34;, &#34;Authorization&#34;: &#34;Bearer {{secrets.SUPPLIER_API_TOKEN}}&#34; }" target="headers" />
            <zeebe:input source="={ &#34;poNumber&#34;: poResult.poNumber, &#34;status&#34;: &#34;REJECTED&#34;, &#34;reason&#34;: &#34;Cold-chain temperature excursion breach&#34; }" target="body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="resultVariable" value="rejectApiResponse" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SlackToRestRejectPO</bpmn:incoming>
        <bpmn:outgoing>Flow_RestRejectToSetResult</bpmn:outgoing>
      </bpmn:serviceTask>

      <bpmn:scriptTask id="Task_SetShipmentRejectedResult" name="Set Shipment Rejected Result">
        <bpmn:extensionElements>
          <zeebe:script expression="={ poNumber: poResult.poNumber, supplierId: poResult.supplierId, status: &#34;REJECTED&#34;, matchStatus: &#34;DISPUTED&#34; }" resultVariable="shipmentResult" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_RestRejectToSetResult</bpmn:incoming>
        <bpmn:outgoing>Flow_RejectedResultToEnd</bpmn:outgoing>
      </bpmn:scriptTask>

      <bpmn:endEvent id="EndEvent_ShipmentRejected" name="Shipment Rejected">
        <bpmn:incoming>Flow_RejectedResultToEnd</bpmn:incoming>
      </bpmn:endEvent>

      <!-- User Task: Confirm Goods Receipt (After Transit) -->
      <bpmn:userTask id="Task_ConfirmGoodsReceipt" name="Confirm Goods Receipt">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="confirmGoodsReceipt" />
          <zeebe:ioMapping>
            <zeebe:input source="=poResult.poNumber" target="poNumber" />
            <zeebe:input source="=poResult.items" target="items" />
            <zeebe:input source="=poResult.amount" target="orderedAmount" />
            <zeebe:input source="=sum(poResult.items.qty)" target="orderedQty" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_TransitToGoodsReceipt</bpmn:incoming>
        <bpmn:outgoing>Flow_GoodsReceiptToCallActivity</bpmn:outgoing>
      </bpmn:userTask>

      <!-- Call Activity: Supplier Invoice Three-Way Match -->
      <bpmn:callActivity id="CallActivity_ThreeWayMatch" name="Supplier Invoice Three-Way Match">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="supplierInvoiceThreeWayMatch" propagateAllChildVariables="false" bindingType="latest" />
          <zeebe:ioMapping>
            <zeebe:input source="=poResult.poNumber" target="poNumber" />
            <zeebe:input source="=sum(poResult.items.qty)" target="orderedQty" />
            <zeebe:input source="=poResult.amount" target="orderedAmount" />
            <zeebe:input source="=receivedQty" target="receivedQty" />
            <zeebe:input source="=invoiceAmount" target="invoiceAmount" />
            <zeebe:input source="=invoiceNumber" target="invoiceNumber" />
            <zeebe:output source="=matchStatus" target="childMatchStatus" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_GoodsReceiptToCallActivity</bpmn:incoming>
        <bpmn:outgoing>Flow_CallActivityToAssembleResult</bpmn:outgoing>
      </bpmn:callActivity>

      <!-- Script Task: Assemble Shipment Result -->
      <bpmn:scriptTask id="Task_AssembleShipmentResult" name="Assemble Shipment Result">
        <bpmn:extensionElements>
          <zeebe:script expression="={ poNumber: poResult.poNumber, supplierId: poResult.supplierId, status: &#34;COMPLETED&#34;, matchStatus: childMatchStatus }" resultVariable="shipmentResult" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_CallActivityToAssembleResult</bpmn:incoming>
        <bpmn:outgoing>Flow_AssembleResultToEnd</bpmn:outgoing>
      </bpmn:scriptTask>

      <bpmn:endEvent id="EndEvent_ShipmentInstanceEnd" name="Shipment Fulfilled">
        <bpmn:incoming>Flow_AssembleResultToEnd</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Main Instance Flows -->
      <bpmn:sequenceFlow id="Flow_ShipmentStartToTransit" sourceRef="StartEvent_ShipmentInstance" targetRef="SubProcess_ColdChainTransit" />
      <bpmn:sequenceFlow id="Flow_TransitToGoodsReceipt" sourceRef="SubProcess_ColdChainTransit" targetRef="Task_ConfirmGoodsReceipt" />
      <bpmn:sequenceFlow id="Flow_GoodsReceiptToCallActivity" sourceRef="Task_ConfirmGoodsReceipt" targetRef="CallActivity_ThreeWayMatch" />
      <bpmn:sequenceFlow id="Flow_CallActivityToAssembleResult" sourceRef="CallActivity_ThreeWayMatch" targetRef="Task_AssembleShipmentResult" />
      <bpmn:sequenceFlow id="Flow_AssembleResultToEnd" sourceRef="Task_AssembleShipmentResult" targetRef="EndEvent_ShipmentInstanceEnd" />

      <!-- Boundary Event Flows -->
      <bpmn:sequenceFlow id="Flow_LateTimerToSlack" sourceRef="BoundaryEvent_DeliveryTimer" targetRef="Task_SlackLateDelivery" />
      <bpmn:sequenceFlow id="Flow_SlackToEmailLateSupplier" sourceRef="Task_SlackLateDelivery" targetRef="Task_EmailSupplierLate" />
      <bpmn:sequenceFlow id="Flow_EmailLateToSetResult" sourceRef="Task_EmailSupplierLate" targetRef="Task_SetShipmentLateResult" />
      <bpmn:sequenceFlow id="Flow_LateResultToEnd" sourceRef="Task_SetShipmentLateResult" targetRef="EndEvent_DeliveryLate" />

      <bpmn:sequenceFlow id="Flow_RejectedToSlack" sourceRef="BoundaryEvent_ShipmentRejected" targetRef="Task_SlackShipmentRejected" />
      <bpmn:sequenceFlow id="Flow_SlackToRestRejectPO" sourceRef="Task_SlackShipmentRejected" targetRef="Task_RestMarkPORejected" />
      <bpmn:sequenceFlow id="Flow_RestRejectToSetResult" sourceRef="Task_RestMarkPORejected" targetRef="Task_SetShipmentRejectedResult" />
      <bpmn:sequenceFlow id="Flow_RejectedResultToEnd" sourceRef="Task_SetShipmentRejectedResult" targetRef="EndEvent_ShipmentRejected" />

    </bpmn:subProcess>

    <!-- 9. Exclusive Gateway: Evaluate Shipment Fulfilment Results -->
    <bpmn:exclusiveGateway id="Gateway_ShipmentResultsSummary" name="All Shipments OK?" default="Flow_AllShipmentsOK">
      <bpmn:incoming>Flow_FulfilmentToSummaryGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_AllShipmentsOK</bpmn:outgoing>
      <bpmn:outgoing>Flow_ShipmentsDiscrepancy</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Email Connector: Summary Email (All OK) -->
    <bpmn:serviceTask id="Task_SendSummaryEmailOK" name="Send Fulfilment Summary Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" />
        <zeebe:ioMapping>
          <zeebe:input source="{{secrets.SMTP_HOST}}" target="host" />
          <zeebe:input source="{{secrets.SMTP_PORT}}" target="port" />
          <zeebe:input source="{{secrets.SMTP_USER}}" target="user" />
          <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="password" />
          <zeebe:input source="replenishment-system@coldchain-replenishment.example" target="from" />
          <zeebe:input source="=storeManagerEmail" target="to" />
          <zeebe:input source="=&#34;Replenishment Completed Successfully: Store &#34; + storeId + &#34; (&#34; + requestId + &#34;)&#34;" target="subject" />
          <zeebe:input source="=&#34;All replenishment shipments for request &#34; + requestId + &#34; have been received and 3-way matched. Results: &#34; + string(shipmentResults)" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AllShipmentsOK</bpmn:incoming>
      <bpmn:outgoing>Flow_SummaryOKToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Email Connector: Discrepancy Escalation Email -->
    <bpmn:serviceTask id="Task_SendDiscrepancyEmail" name="Send Discrepancy Alert Email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" />
        <zeebe:ioMapping>
          <zeebe:input source="{{secrets.SMTP_HOST}}" target="host" />
          <zeebe:input source="{{secrets.SMTP_PORT}}" target="port" />
          <zeebe:input source="{{secrets.SMTP_USER}}" target="user" />
          <zeebe:input source="{{secrets.SMTP_PASSWORD}}" target="password" />
          <zeebe:input source="replenishment-system@coldchain-replenishment.example" target="from" />
          <zeebe:input source="=storeManagerEmail" target="to" />
          <zeebe:input source="=&#34;ATTENTION: Replenishment Discrepancies Detected for Request &#34; + requestId" target="subject" />
          <zeebe:input source="=&#34;One or more purchase orders encountered cold-chain rejections or invoice disputes. Detailed report: &#34; + string(shipmentResults)" target="body" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ShipmentsDiscrepancy</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscrepancyToJoin</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Exclusive Gateway Join before End -->
    <bpmn:exclusiveGateway id="Gateway_FinalJoin" name="Join Final Completion" default="Flow_FinalJoinToEnd">
      <bpmn:incoming>Flow_SummaryOKToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_DiscrepancyToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalJoinToEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Final End Event -->
    <bpmn:endEvent id="EndEvent_ReplenishmentCompleted" name="Replenishment Completed">
      <bpmn:incoming>Flow_FinalJoinToEnd</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Top-Level Sequence Flows -->
    <bpmn:sequenceFlow id="Flow_StartToReview" sourceRef="StartEvent_ReplenishmentRequested" targetRef="Task_ReviewRequest" />
    <bpmn:sequenceFlow id="Flow_ReviewToGateway" sourceRef="Task_ReviewRequest" targetRef="Gateway_RequestApproved" />
    <bpmn:sequenceFlow id="Flow_RequestApproved" name="Approved" sourceRef="Gateway_RequestApproved" targetRef="SubProcess_RFQPerSupplier" />
    <bpmn:sequenceFlow id="Flow_RequestRejected" name="Rejected" sourceRef="Gateway_RequestApproved" targetRef="EndEvent_RequestRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=requestApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RFQToQuoteGateway" sourceRef="SubProcess_RFQPerSupplier" targetRef="Gateway_AnyValidQuote" />
    <bpmn:sequenceFlow id="Flow_ValidQuotesPresent" name="Quotes Received &gt; 0" sourceRef="Gateway_AnyValidQuote" targetRef="Task_RankSelectSuppliers">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(quotes[item.responded = true]) &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoQuotesAlert" name="No Valid Quotes" sourceRef="Gateway_AnyValidQuote" targetRef="Task_AlertNoQuotes" />
    <bpmn:sequenceFlow id="Flow_AlertToNoQuotesEnd" sourceRef="Task_AlertNoQuotes" targetRef="EndEvent_NoQuotesEscalated" />
    <bpmn:sequenceFlow id="Flow_RankToIssuePOs" sourceRef="Task_RankSelectSuppliers" targetRef="SubProcess_IssuePurchaseOrders" />
    <bpmn:sequenceFlow id="Flow_IssuePOsToFulfilment" sourceRef="SubProcess_IssuePurchaseOrders" targetRef="SubProcess_ShipmentFulfilment" />
    <bpmn:sequenceFlow id="Flow_FulfilmentToSummaryGateway" sourceRef="SubProcess_ShipmentFulfilment" targetRef="Gateway_ShipmentResultsSummary" />
    <bpmn:sequenceFlow id="Flow_AllShipmentsOK" name="All Fulfilled &amp; Matched" sourceRef="Gateway_ShipmentResultsSummary" targetRef="Task_SendSummaryEmailOK" />
    <bpmn:sequenceFlow id="Flow_ShipmentsDiscrepancy" name="Discrepancy or Rejection" sourceRef="Gateway_ShipmentResultsSummary" targetRef="Task_SendDiscrepancyEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=some r in shipmentResults satisfies r.matchStatus = "DISPUTED" or r.status = "REJECTED" or r.status = "LATE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SummaryOKToJoin" sourceRef="Task_SendSummaryEmailOK" targetRef="Gateway_FinalJoin" />
    <bpmn:sequenceFlow id="Flow_DiscrepancyToJoin" sourceRef="Task_SendDiscrepancyEmail" targetRef="Gateway_FinalJoin" />
    <bpmn:sequenceFlow id="Flow_FinalJoinToEnd" sourceRef="Gateway_FinalJoin" targetRef="EndEvent_ReplenishmentCompleted" />

  </bpmn:process>

  <!-- Visual Diagram Information (BPMN DI) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_ColdChainReplenishment">
    <bpmndi:BPMNPlane id="BPMNPlane_ColdChainReplenishment" bpmnElement="coldChainReplenishment">

      <!-- Top-Level Process Shapes -->
      <bpmndi:BPMNShape id="Shape_StartEvent_ReplenishmentRequested" bpmnElement="StartEvent_ReplenishmentRequested">
        <dc:Bounds x="160" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="144" y="365" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_ReviewRequest" bpmnElement="Task_ReviewRequest">
        <dc:Bounds x="250" y="300" width="130" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Gateway_RequestApproved" bpmnElement="Gateway_RequestApproved" isMarkerVisible="true">
        <dc:Bounds x="435" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="433" y="285" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_EndEvent_RequestRejected" bpmnElement="EndEvent_RequestRejected">
        <dc:Bounds x="442" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="417" y="485" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- SubProcess_RFQPerSupplier -->
      <bpmndi:BPMNShape id="Shape_SubProcess_RFQPerSupplier" bpmnElement="SubProcess_RFQPerSupplier" isExpanded="true">
        <dc:Bounds x="540" y="160" width="870" height="360" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>

