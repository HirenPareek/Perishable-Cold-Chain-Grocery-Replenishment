# ==============================================================================
# CAMUNDA 8 OUTBOUND CONNECTOR SECRETS CONFIGURATION
# Project 20: Perishable Cold-Chain Grocery Replenishment
#
# In Camunda 8 (SaaS or Self-Managed), configure these secrets in:
# - Camunda 8 SaaS: Console -> Clusters -> Cluster Details -> Connectors -> Secrets
# - Camunda 8 Self-Managed / Run: Environment variables with prefix 'CAMUNDA_CONNECTOR_SECRETS_'
#   e.g., CAMUNDA_CONNECTOR_SECRETS_IOT_API_BASE_URL=https://api.coldchain.internal
# ==============================================================================

# IoT Cold-Chain Telemetry REST API
IOT_API_BASE_URL=https://telemetry-mock.coldchain.internal/api/v1
IOT_API_TOKEN=mock-iot-telemetry-bearer-token-xyz789

# Supplier Purchase Order REST API
SUPPLIER_API_BASE_URL=https://supplier-portal-mock.internal/api/v1
SUPPLIER_API_TOKEN=mock-supplier-api-bearer-token-abc123

# SMTP / Email Connector Configuration
SMTP_HOST=mailhog.internal
SMTP_PORT=1025
SMTP_USER=procurement-notifications@coldchain.internal
SMTP_PASSWORD=secret-smtp-password-placeholder

# Slack Outbound Connector Configuration
SLACK_BOT_TOKEN=xoxb-mock-slack-bot-token-coldchain-qa-alert
